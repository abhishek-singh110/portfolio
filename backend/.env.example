# Copy to .env and adjust. Load it with:
#   .\.venv\Scripts\python.exe -m uvicorn main:app --port 8000 --env-file .env
# Every value below is optional — these are the defaults used when a variable is not set.

OLLAMA_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
TOP_K=3
SOURCE_MIN_COSINE=0.6

# Comma-separated list of sites allowed to call the API (add your live domain when deploying)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
RATE_LIMIT_PER_MIN=15
